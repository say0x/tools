// Prisma schema for the "tools" suite — starts with the Immobilien-Rechner.
// Design principle: the DB stores raw inputs only. Every derived figure
// (Renditen, Tilgungsplan, Kostenschätzungen, ...) is computed at runtime by
// the calc engine in src/server/calc. Fields that follow the
// "computed-with-override" pattern (a value + an `xOverride` boolean) let the
// engine auto-derive a default while still allowing a manual value to win.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cross-tool foundation
// ---------------------------------------------------------------------------

enum AssetType {
  IMMOBILIE
  WERTPAPIERDEPOT
  TAGESGELD
}

/// Verwendungszweck eines Assets — steuert, ob es automatisch im Vermögen
/// (Finanzübersicht) mitgezählt wird, oder nur für Szenarien/Kalkulationen
/// zur Verfügung steht. Bewusst auf Asset-Ebene (nicht pro Detailtabelle),
/// damit jeder heutige und künftige Asset-Typ (Immobilie, Wertpapier,
/// Fahrzeug, Kredit, ...) denselben Status ohne Zusatzcode bekommt.
enum Besitzstatus {
  /// Gehört tatsächlich zum aktuellen Vermögen — zählt automatisch in der Finanzübersicht mit.
  BESITZE_ICH
  /// Noch nicht gekauft/eingerichtet — nur für "Was wäre wenn"-Szenarien, zählt NICHT im aktuellen Vermögen.
  POTENZIELLE_ANSCHAFFUNG
  /// Rein hypothetische Kalkulation ("lohnt sich das überhaupt?"), kein konkreter Kaufplan.
  SPEKULATION
  /// Ehemals besessen, mittlerweile veräußert — bleibt für Historie/Auswertung erhalten.
  VERKAUFT
  /// Nicht mehr aktiv relevant, aber nicht gelöscht (z. B. alte Kalkulation).
  ARCHIVIERT
}

/// Every tool in the suite attaches one Asset row per position it manages.
/// Future tools (Fahrzeuge, Kredite, ...) add their own AssetType + detail
/// table and a shared "Finanzielle Freiheit" view can aggregate over Asset
/// without needing to know about typ-spezifische Spalten.
model Asset {
  id        String    @id @default(cuid())
  type      AssetType
  name      String
  /// Default: POTENZIELLE_ANSCHAFFUNG — ein neu angelegtes Asset zählt erst nach
  /// bewusster Bestätigung ("das besitze ich wirklich") im Vermögen mit.
  besitzstatus Besitzstatus @default(POTENZIELLE_ANSCHAFFUNG)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  property           Property?
  wertpapierposition Wertpapierposition?
  tagesgeldkonto     Tagesgeldkonto?
  szenarioAenderungen SzenarioAenderung[]
}

// ---------------------------------------------------------------------------
// User profile (single user, upsert pattern — no auth/multi-tenancy needed)
// ---------------------------------------------------------------------------

model UserProfile {
  id String @id @default(cuid())

  nettoEinkommenMonatlich Decimal @default(0) @db.Decimal(14, 2)
  bruttoEinkommenMonatlich Decimal @default(0) @db.Decimal(14, 2)
  // computed-with-override: bei zvEOverride=false wird das zvE live aus dem
  // Brutto-Einkommen geschätzt (Pauschbeträge), sonst gilt der manuelle Wert.
  zuVersteuerndesEinkommenJaehrlich Decimal @default(0) @db.Decimal(14, 2)
  zvEOverride             Boolean @default(false)
  fixkostenMonatlich      Decimal @default(0) @db.Decimal(14, 2)
  vorhandenesEigenkapital Decimal @default(0) @db.Decimal(14, 2)

  // Konfigurierbare Affordability-Schwellen, bewusst als Felder statt Konstanten.
  maxSchuldendienstquoteProzent  Decimal @default(35) @db.Decimal(7, 4)
  mindestLiquiditaetsreserveEuro Decimal @default(10000) @db.Decimal(14, 2)
  /// Anteil der erwarteten Nettomiete eines Objekts, den die Bank bei der
  /// Schuldendienstquote als zusätzliches Einkommen anrechnet (Kapitaldienstfähigkeit).
  mietanrechnungProzent          Decimal @default(80) @db.Decimal(7, 4)
  /// Mindest-Eigenkapitalrendite, unterhalb derer die Kapitaleffizienz-Ampel warnt.
  mindestEigenkapitalrenditeProzent Decimal @default(4) @db.Decimal(7, 4)
  /// EK-Einsatz, ab dem die Kapitaleffizienz-Prüfung überhaupt greift (bei
  /// kleinen EK-Beträgen, z.B. 100%-Finanzierung, ist die % sonst irreführend volatil).
  eigenkapitalPruefungAbEuro        Decimal @default(5000) @db.Decimal(14, 2)
  /// "Rechnet sich das?"-Ampel: wie viel Prozent der effektiven Kaltmiete der
  /// Cashflow nach Steuer in Jahr 1 höchstens im Minus sein darf, bevor Rot greift.
  cashflowStartverlustMaxProzentKaltmiete Decimal @default(30) @db.Decimal(7, 4)
  /// "Rechnet sich das?"-Ampel: bis zu welchem Jahr der Cashflow nach Steuer
  /// spätestens ins Plus gedreht haben muss, sonst Rot.
  cashflowUmschlagjahr                    Int   @default(10)

  /// Für die Finanzübersicht: erwartete jährliche Steigerung des Brutto-Einkommens
  /// (bruttoEinkommenMonatlich * 12), rein informativ dargestellt und als
  /// Vorschlagswert für die Sparplan-Steigerung neuer Positionen genutzt.
  gehaltssteigerungProzentJaehrlich Decimal @default(2) @db.Decimal(7, 4)
  /// Für die Finanzübersicht: angenommene Inflationsrate, mit der die
  /// "real"-Linie im Vermögensverlauf-Chart abgezinst wird.
  inflationProzentJaehrlich         Decimal @default(2) @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liabilities UserLiability[]
}

/// Bestehende Kredite/Verbindlichkeiten des Nutzers, einzeln statt als Summe,
/// damit die Schuldendienstquote sauber mit bestehenden Raten rechnen kann.
model UserLiability {
  id            String @id @default(cuid())
  profileId     String
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  bezeichnung       String
  monatlicheRate    Decimal @db.Decimal(14, 2)
  restschuld        Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Property (Immobilien-Objekt)
// ---------------------------------------------------------------------------

enum Bundesland {
  BADEN_WUERTTEMBERG
  BAYERN
  BERLIN
  BRANDENBURG
  BREMEN
  HAMBURG
  HESSEN
  MECKLENBURG_VORPOMMERN
  NIEDERSACHSEN
  NORDRHEIN_WESTFALEN
  RHEINLAND_PFALZ
  SAARLAND
  SACHSEN
  SACHSEN_ANHALT
  SCHLESWIG_HOLSTEIN
  THUERINGEN
}

enum Lagetyp {
  LAENDLICH
  KLEINSTADT
  GROSSSTADT
}

enum Objekttyp {
  ETW
  MEHRFAMILIENHAUS
  HAUS
}

enum Sanierungsmodus {
  PAUSCHAL
  GRANULAR
}

model Property {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kaufpreis       Decimal @db.Decimal(14, 2)
  kaufdatum       DateTime @default(now())
  wohnflaeche     Float
  bundesland      Bundesland
  lagetyp         Lagetyp
  objekttyp       Objekttyp
  baujahr         Int
  anzahlEinheiten Int @default(1)

  // kaufdatum darf auch in der Zukunft liegen (geplanter Kauf) — die
  // Finanzübersicht simuliert den EK-Abfluss dann erst ab dem Kaufjahr.
  // Ob das Objekt im Vermögen mitgezählt wird, steuert asset.besitzstatus
  // (gilt einheitlich für alle Asset-Typen, nicht nur Immobilien).

  // Kaufnebenkosten — computed-with-override
  grunderwerbsteuerProzent Decimal @default(0) @db.Decimal(7, 4)
  grunderwerbsteuerOverride Boolean @default(false)
  notarProzent             Decimal @default(1.0) @db.Decimal(7, 4)
  notarOverride            Boolean @default(false)
  grundbuchProzent         Decimal @default(0.5) @db.Decimal(7, 4)
  grundbuchOverride        Boolean @default(false)
  maklerprovisionProzent   Decimal @default(0) @db.Decimal(7, 4)
  maklerprovisionOverride  Boolean @default(false)

  // Sanierung / Sofortinvestition
  sanierungsmodus        Sanierungsmodus @default(PAUSCHAL)
  sofortinvestitionPauschal Decimal @default(0) @db.Decimal(14, 2)

  // WEG-Miteigentumsanteil (nur relevant für Gemeinschaftseigentum-Gewerke)
  /// Gesamtwohnfläche des Gebäudes/der WEG — Basis für die automatische
  /// Miteigentumsanteil-Herleitung. Ohne Angabe entspricht das Ergebnis dem
  /// bisherigen Verhalten (eigene Wohnfläche als Näherung).
  gebaeudeWohnflaecheGesamt Float?
  /// computed-with-override: ohne Override wird der Anteil aus
  /// eigeneWohnflaeche/gebaeudeWohnflaecheGesamt hergeleitet (bzw. 100%, wenn
  /// keine Gesamtwohnfläche hinterlegt ist); mit Override gilt der
  /// tatsächliche Anteil aus Grundbuch/Teilungserklärung.
  miteigentumsanteilProzent Decimal @default(100) @db.Decimal(7, 4)
  miteigentumsanteilOverride Boolean @default(false)

  // Miete
  kaltmieteMonatlich            Decimal @db.Decimal(14, 2)
  mietsteigerungProzentJaehrlich Decimal @default(1.5) @db.Decimal(7, 4)

  // Wertentwicklung — wirkt immer im Vermögensverlauf, unabhängig vom Exit-Plan
  wertsteigerungProzentJaehrlich   Decimal @default(2) @db.Decimal(7, 4)
  kostensteigerungProzentJaehrlich Decimal @default(2) @db.Decimal(7, 4)

  // Laufende Kosten
  hausgeldUmlagefaehigMonatlich    Decimal @default(0) @db.Decimal(14, 2)
  hausgeldNichtUmlagefaehigMonatlich Decimal @default(0) @db.Decimal(14, 2)
  grundsteuerJaehrlich              Decimal @default(0) @db.Decimal(14, 2)
  instandhaltungsruecklageMonatlich Decimal @default(0) @db.Decimal(14, 2)
  instandhaltungsruecklageOverride  Boolean @default(false)
  verwaltungskostenMonatlich        Decimal @default(0) @db.Decimal(14, 2)
  leerstandsquoteProzent            Decimal @default(2) @db.Decimal(7, 4)
  versicherungJaehrlich             Decimal @default(0) @db.Decimal(14, 2)
  versicherungUmlagefaehig          Boolean @default(false)

  // Steuer (Näherung)
  afaSatzProzent         Decimal @default(2) @db.Decimal(7, 4)
  /// computed-with-override: ohne Override wird der AfA-Satz aus dem Baujahr
  /// hergeleitet (§7 Abs. 4 EStG: 2%, bzw. 2,5% bei Baujahr vor 1925).
  afaSatzProzentOverride Boolean @default(false)
  afaSonderabschreibung  Boolean @default(false)

  // Ansprechpartner / Makler — reine Metadaten, fließen nicht in die Kalkulation ein
  ansprechpartnerName     String @default("")
  ansprechpartnerTelefon  String @default("")
  ansprechpartnerEmail    String @default("")
  ansprechpartnerNotizen  String @default("")

  /// Freitext-Notizen zum Objekt selbst — z.B. welche Werte beim Anlegen
  /// geschätzt/angenommen wurden, weil sie nicht in der Quelle standen.
  /// Reine Metadaten, fließen nicht in die Kalkulation ein.
  notizen   String @default("")
  /// Link zum ursprünglichen Exposé (Kleinanzeigen, ImmoScout24, Immowelt, ...).
  quelleUrl String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financing PropertyFinancing?
  gewerke   PropertyGewerk[]
  exit      PropertyExit?
}

enum Finanzierungsart {
  FINANZIERUNG_100
  FINANZIERUNG_110
  MANUELL
}

model PropertyFinancing {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  eigenkapital                  Decimal @default(0) @db.Decimal(14, 2)
  zinssatzProzent                Decimal @default(3.5) @db.Decimal(7, 4)
  anfaenglicheTilgungProzent     Decimal @default(2) @db.Decimal(7, 4)
  zinsbindungJahre               Int   @default(10)
  finanzierungsart                Finanzierungsart @default(FINANZIERUNG_110)
  eigenkapitalquoteManuellProzent Decimal? @db.Decimal(7, 4)
  /// Anschlussfinanzierung nach jedem Ablauf der Zinsbindung: der neue Zinssatz
  /// wird als (zuletzt gültiger Zins + anschlusszinsAufschlagProzent) angenommen,
  /// ab da mit gleichem Tilgungssatz neu auf die dann aktuelle Restschuld berechnet.
  /// Läuft die Zinsbindung im Betrachtungszeitraum mehrfach ab, wird dieser
  /// Aufschlag bei jeder Anschlussfinanzierung erneut angewandt (kumulativ).
  anschlusszinsAufschlagProzent  Decimal @default(1) @db.Decimal(7, 4)
  /// Geplante jährliche Sondertilgung, in % der ursprünglichen Darlehenssumme
  /// (nicht der jeweils aktuellen Restschuld — entspricht der üblichen
  /// vertraglichen Definition des Sondertilgungsrechts). Default 0 = keine
  /// Sondertilgung geplant. Reduziert die Restschuld zusätzlich zur regulären
  /// Tilgung, wirkt sich aber NICHT auf die laufende monatliche Cashflow-/
  /// Schuldendienst-Berechnung aus (bewusste Vereinfachung: wie eine separate
  /// Kapitaleinlage behandelt, nicht wie eine laufende Kostenposition).
  sondertilgungProzent    Decimal @default(0) @db.Decimal(7, 4)
  /// Vertraglich maximal erlaubte jährliche Sondertilgung (% der ursprünglichen
  /// Darlehenssumme) — sondertilgungProzent darf diesen Wert nie überschreiten.
  sondertilgungMaxProzent Decimal @default(5) @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gewerk {
  DACH
  FENSTER
  HEIZUNG
  ELEKTRIK
  SANITAER_BAEDER
  MAUERWERK_FASSADE
  BODENBELAEGE
  SONSTIGES
}

enum EigentumsTyp {
  SONDEREIGENTUM
  GEMEINSCHAFTSEIGENTUM
}

/// Nur für Gewerk FENSTER relevant — beeinflusst die Kostenschätzung zusätzlich zum Zustand.
enum Verglasungsart {
  EINFACH
  DOPPEL
  DREIFACH
}

model PropertyGewerk {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  gewerk               Gewerk
  zustand              Int          @default(3) // 1 (sehr gut) – 6 (sehr schlecht)
  eigentumsTyp         EigentumsTyp @default(SONDEREIGENTUM)
  geschaetzteKostenOverride Decimal? @db.Decimal(14, 2)
  kommentar            String?
  /// Baujahr/Einbaujahr dieses Gewerks (optional) — Alter fließt in Formel-Kontext & Verhandlungsargumente ein.
  baujahr              Int?
  /// Nur bei gewerk = FENSTER ausgewertet.
  verglasung           Verglasungsart?
  /// Bei false zählt der Kostenbetrag nicht in die Sofortinvestition, sondern
  /// wird nur informativ als "für später eingeplant" ausgewiesen.
  sofortSanieren       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model PropertyExit {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  geplant        Boolean @default(false)
  haltedauerJahre Int    @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Wertpapierdepot & Tagesgeld (Finanzübersicht) — manuell erfasste Positionen,
// keine Live-Kursanbindung. Jede Position wächst im Vermögensverlauf mit
// ihrer eigenen Rendite/Zins und einem optionalen monatlichen Sparplan.
// ---------------------------------------------------------------------------

model Wertpapierposition {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Aktueller Depotwert (heute), keine Live-Kursanbindung.
  betrag                   Decimal @db.Decimal(14, 2)
  renditeProzentJaehrlich  Decimal @default(7) @db.Decimal(7, 4)
  /// Zusätzlicher monatlicher Sparplan in diese Position — optional, 0 = kein Sparplan.
  sparplanBetragMonatlich  Decimal @default(0) @db.Decimal(14, 2)
  /// Jährliche Steigerung des Sparplan-Betrags (z. B. analog zur Gehaltssteigerung).
  sparplanSteigerungProzentJaehrlich Decimal @default(0) @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tagesgeldkonto {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Aktueller Kontostand (heute).
  betrag                   Decimal @db.Decimal(14, 2)
  zinsProzentJaehrlich     Decimal @default(2) @db.Decimal(7, 4)
  /// Zusätzlicher monatlicher Sparplan auf dieses Konto — optional, 0 = kein Sparplan.
  sparplanBetragMonatlich  Decimal @default(0) @db.Decimal(14, 2)
  /// Jährliche Steigerung des Sparplan-Betrags (z. B. analog zur Gehaltssteigerung).
  sparplanSteigerungProzentJaehrlich Decimal @default(0) @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Referenzdaten (im UI editierbar, dienen als Startwerte/Vergleichsbasis)
// ---------------------------------------------------------------------------

model ReferenceGrunderwerbsteuer {
  id           String     @id @default(cuid())
  bundesland   Bundesland @unique
  satzProzent  Decimal @db.Decimal(7, 4)
  gueltigAb    DateTime   @default(now())
  quelle       String?
  updatedAt    DateTime   @updatedAt
}

model ReferenceMietpreis {
  id             String     @id @default(cuid())
  bundesland     Bundesland
  lagetyp        Lagetyp
  mietpreisProM2 Decimal @db.Decimal(14, 2)
  aktualisiertAm DateTime   @default(now())

  @@unique([bundesland, lagetyp])
}

model ReferenceGewerkKosten {
  id             String     @id @default(cuid())
  gewerk         Gewerk     @unique
  kostenProM2Min Decimal @db.Decimal(14, 2)
  kostenProM2Max Decimal @db.Decimal(14, 2)
  aktualisiertAm DateTime   @default(now())
}

model ReferenceInstandhaltungssatz {
  id                    String   @id @default(cuid())
  altersklasseVonJahren Int
  altersklasseBisJahren Int?
  satzProM2ProJahr      Decimal @db.Decimal(14, 2)
  aktualisiertAm        DateTime @default(now())
}

/// Typische Nutzungsdauer je Gewerk (Jahre) — grober Richtwert, keine
/// Herstellerangabe. Dient als Vergleichsbasis für Verhandlungsargumente,
/// wenn ein Gewerk-Baujahr erfasst wurde.
model ReferenceNutzungsdauer {
  id                String   @id @default(cuid())
  gewerk            Gewerk   @unique
  nutzungsdauerJahre Int
  aktualisiertAm    DateTime @default(now())
}

/// Singleton (wie UserProfile) für allgemeine Standardwerte, die neue
/// Objekte vorausfüllen bzw. die computed-with-override-Felder vorschlagen.
/// Alle "standard*"-Felder sind bewusst nullable: null = kein Standard
/// gesetzt, das hartcodierte Fallback aus defaultPropertyFormValues() gilt.
/// Jedes vorausgefüllte Feld bleibt pro Objekt frei überschreibbar.
model ReferenceKaufnebenkostenDefaults {
  id                 String      @id @default(cuid())
  notarProzent       Decimal     @default(1.0) @db.Decimal(7, 4)
  grundbuchProzent   Decimal     @default(0.5) @db.Decimal(7, 4)
  standardBundesland Bundesland?

  standardZinssatzProzent         Decimal? @db.Decimal(7, 4)
  standardTilgungProzent          Decimal? @db.Decimal(7, 4)
  standardZinsbindungJahre        Int?
  standardFinanzierungsart        Finanzierungsart?
  standardMietsteigerungProzent   Decimal? @db.Decimal(7, 4)
  standardWertsteigerungProzent   Decimal? @db.Decimal(7, 4)
  standardKostensteigerungProzent Decimal? @db.Decimal(7, 4)
  standardLeerstandsquoteProzent  Decimal? @db.Decimal(7, 4)
  standardAnschlusszinsAufschlagProzent Decimal? @db.Decimal(7, 4)
  standardSondertilgungProzent    Decimal? @db.Decimal(7, 4)
  standardSondertilgungMaxProzent Decimal? @db.Decimal(7, 4)

  updatedAt DateTime @updatedAt
}

/// Vergleichswert für Kaufpreisfaktor (= Kaufpreis / Jahreskaltmiete) je
/// Objekttyp und Lagetyp — Bruttomietrendite ergibt sich als Kehrwert
/// (100 / Kaufpreisfaktor) und wird nicht separat gespeichert, damit beide
/// Werte nicht auseinanderlaufen können. Dient als Verhandlungs-Referenz.
model ReferenceKaufpreisfaktor {
  id                      String   @id @default(cuid())
  objekttyp               Objekttyp
  lagetyp                 Lagetyp
  kaufpreisfaktorReferenz Decimal @db.Decimal(7, 4)
  aktualisiertAm          DateTime @default(now())

  @@unique([objekttyp, lagetyp])
}

// ---------------------------------------------------------------------------
// Szenarien ("Was wäre wenn?") — verändern NIE die echten Asset-Daten. Ein
// Szenario ist Basiszustand (die vorhandenen BESITZE_ICH-Assets, unverändert)
// + eine Liste von Änderungen, die nur zur Laufzeit in der Calc-Engine auf
// eine Kopie der Inputs angewendet werden (siehe src/server/calc/rendite/
// portfolioverlauf.ts). Löschen/Ändern eines Szenarios hat keinerlei
// Rückwirkung auf Property/Wertpapierposition/Tagesgeldkonto.
// ---------------------------------------------------------------------------

enum SzenarioAenderungTyp {
  /// Eine vorhandene Immobilie (Status "Potenzielle Anschaffung"/"Spekulation") wird im Szenario ab ihrem Kaufdatum so behandelt, als wäre sie "Besitze ich".
  IMMOBILIE_AUFNEHMEN
  /// Eine vorhandene, tatsächlich besessene Immobilie wird im Szenario ab einem gewählten Jahr verkauft (Cashflow endet, Marktwert-Referenz fließt einmalig als Verkaufserlös zu).
  IMMOBILIE_VERKAUFEN
  /// Ändert ab dem Szenario-Startjahr die monatliche Sparrate einer vorhandenen Wertpapier-/Tagesgeld-Position.
  SPARRATE_AENDERN
  /// Frei benannte einmalige Ausgabe zu einem gewählten Jahr (z. B. Autokauf) — reduziert das verfügbare Geld einmalig, ohne dass dafür ein eigenes Asset/Tool nötig ist.
  EINMALIGE_ANSCHAFFUNG
}

model Szenario {
  id        String   @id @default(cuid())
  name      String
  /// Jahr, ab dem die Änderungen dieses Szenarios wirken (z. B. 2028) — einzelne Änderungen können eigene Zeitpunkte haben (Kaufdatum der Immobilie, Anschaffungsjahr), die Sparraten-Änderung greift ab diesem Startjahr.
  startjahr Int
  notizen   String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aenderungen SzenarioAenderung[]
}

model SzenarioAenderung {
  id         String   @id @default(cuid())
  szenarioId String
  szenario   Szenario @relation(fields: [szenarioId], references: [id], onDelete: Cascade)

  typ SzenarioAenderungTyp

  /// Bei IMMOBILIE_AUFNEHMEN / IMMOBILIE_VERKAUFEN / SPARRATE_AENDERN: das referenzierte Asset. Wird das Asset gelöscht, verliert die Änderung ihren Bezug und wird mitgelöscht.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// SPARRATE_AENDERN: neue monatliche Sparrate ab dem Szenario-Startjahr.
  neueSparrateMonatlich Decimal? @db.Decimal(14, 2)

  /// IMMOBILIE_VERKAUFEN: Jahre ab heute, in dem der Verkauf stattfindet.
  /// EINMALIGE_ANSCHAFFUNG: Jahre ab heute, in dem die Ausgabe anfällt.
  jahrAbHeute Int?

  /// EINMALIGE_ANSCHAFFUNG: Bezeichnung (z. B. "Auto") und Betrag.
  bezeichnung String?
  betrag      Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
