// Prisma schema for the "tools" suite — starts with the Immobilien-Rechner.
// Design principle: the DB stores raw inputs only. Every derived figure
// (Renditen, Tilgungsplan, Kostenschätzungen, ...) is computed at runtime by
// the calc engine in src/server/calc. Fields that follow the
// "computed-with-override" pattern (a value + an `xOverride` boolean) let the
// engine auto-derive a default while still allowing a manual value to win.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cross-tool foundation
// ---------------------------------------------------------------------------

enum AssetType {
  IMMOBILIE
}

/// Every tool in the suite attaches one Asset row per position it manages.
/// Future tools (Depot, Sparplan, ...) add their own AssetType + detail table
/// and a shared "Finanzielle Freiheit" view can aggregate over Asset without
/// needing to know about Immobilie-specific columns.
model Asset {
  id        String    @id @default(cuid())
  type      AssetType
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  property Property?
}

// ---------------------------------------------------------------------------
// User profile (single user, upsert pattern — no auth/multi-tenancy needed)
// ---------------------------------------------------------------------------

model UserProfile {
  id String @id @default(cuid())

  nettoEinkommenMonatlich Float @default(0)
  bruttoEinkommenMonatlich Float @default(0)
  // computed-with-override: bei zvEOverride=false wird das zvE live aus dem
  // Brutto-Einkommen geschätzt (Pauschbeträge), sonst gilt der manuelle Wert.
  zuVersteuerndesEinkommenJaehrlich Float @default(0)
  zvEOverride             Boolean @default(false)
  fixkostenMonatlich      Float @default(0)
  vorhandenesEigenkapital Float @default(0)

  // Konfigurierbare Affordability-Schwellen, bewusst als Felder statt Konstanten.
  maxSchuldendienstquoteProzent  Float @default(35)
  mindestLiquiditaetsreserveEuro Float @default(10000)
  /// Anteil der erwarteten Nettomiete eines Objekts, den die Bank bei der
  /// Schuldendienstquote als zusätzliches Einkommen anrechnet (Kapitaldienstfähigkeit).
  mietanrechnungProzent          Float @default(80)
  /// Mindest-Eigenkapitalrendite, unterhalb derer die Kapitaleffizienz-Ampel warnt.
  mindestEigenkapitalrenditeProzent Float @default(4)
  /// EK-Einsatz, ab dem die Kapitaleffizienz-Prüfung überhaupt greift (bei
  /// kleinen EK-Beträgen, z.B. 100%-Finanzierung, ist die % sonst irreführend volatil).
  eigenkapitalPruefungAbEuro        Float @default(5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liabilities UserLiability[]
}

/// Bestehende Kredite/Verbindlichkeiten des Nutzers, einzeln statt als Summe,
/// damit die Schuldendienstquote sauber mit bestehenden Raten rechnen kann.
model UserLiability {
  id            String @id @default(cuid())
  profileId     String
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  bezeichnung       String
  monatlicheRate    Float
  restschuld        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Property (Immobilien-Objekt)
// ---------------------------------------------------------------------------

enum Bundesland {
  BADEN_WUERTTEMBERG
  BAYERN
  BERLIN
  BRANDENBURG
  BREMEN
  HAMBURG
  HESSEN
  MECKLENBURG_VORPOMMERN
  NIEDERSACHSEN
  NORDRHEIN_WESTFALEN
  RHEINLAND_PFALZ
  SAARLAND
  SACHSEN
  SACHSEN_ANHALT
  SCHLESWIG_HOLSTEIN
  THUERINGEN
}

enum Lagetyp {
  LAENDLICH
  KLEINSTADT
  GROSSSTADT
}

enum Objekttyp {
  ETW
  MEHRFAMILIENHAUS
  HAUS
}

enum Sanierungsmodus {
  PAUSCHAL
  GRANULAR
}

model Property {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kaufpreis       Float
  kaufdatum       DateTime @default(now())
  wohnflaeche     Float
  bundesland      Bundesland
  lagetyp         Lagetyp
  objekttyp       Objekttyp
  baujahr         Int
  anzahlEinheiten Int @default(1)

  // Kaufnebenkosten — computed-with-override
  grunderwerbsteuerProzent Float   @default(0)
  grunderwerbsteuerOverride Boolean @default(false)
  notarProzent             Float   @default(1.0)
  notarOverride            Boolean @default(false)
  grundbuchProzent         Float   @default(0.5)
  grundbuchOverride        Boolean @default(false)
  maklerprovisionProzent   Float   @default(0)
  maklerprovisionOverride  Boolean @default(false)

  // Sanierung / Sofortinvestition
  sanierungsmodus        Sanierungsmodus @default(PAUSCHAL)
  sofortinvestitionPauschal Float @default(0)

  // Miete
  kaltmieteMonatlich            Float
  mietsteigerungProzentJaehrlich Float @default(1.5)

  // Wertentwicklung — wirkt immer im Vermögensverlauf, unabhängig vom Exit-Plan
  wertsteigerungProzentJaehrlich   Float @default(2)
  kostensteigerungProzentJaehrlich Float @default(2)

  // Laufende Kosten
  hausgeldUmlagefaehigMonatlich    Float @default(0)
  hausgeldNichtUmlagefaehigMonatlich Float @default(0)
  grundsteuerJaehrlich              Float @default(0)
  instandhaltungsruecklageMonatlich Float @default(0)
  instandhaltungsruecklageOverride  Boolean @default(false)
  verwaltungskostenMonatlich        Float @default(0)
  leerstandsquoteProzent            Float @default(2)
  versicherungJaehrlich             Float @default(0)
  versicherungUmlagefaehig          Boolean @default(false)

  // Steuer (Näherung)
  afaSatzProzent         Float   @default(2)
  /// computed-with-override: ohne Override wird der AfA-Satz aus dem Baujahr
  /// hergeleitet (§7 Abs. 4 EStG: 2%, bzw. 2,5% bei Baujahr vor 1925).
  afaSatzProzentOverride Boolean @default(false)
  afaSonderabschreibung  Boolean @default(false)

  // Ansprechpartner / Makler — reine Metadaten, fließen nicht in die Kalkulation ein
  ansprechpartnerName     String @default("")
  ansprechpartnerTelefon  String @default("")
  ansprechpartnerEmail    String @default("")
  ansprechpartnerNotizen  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financing PropertyFinancing?
  gewerke   PropertyGewerk[]
  exit      PropertyExit?
}

enum Finanzierungsart {
  FINANZIERUNG_100
  FINANZIERUNG_110
  MANUELL
}

model PropertyFinancing {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  eigenkapital                  Float @default(0)
  zinssatzProzent                Float @default(3.5)
  anfaenglicheTilgungProzent     Float @default(2)
  zinsbindungJahre               Int   @default(10)
  finanzierungsart                Finanzierungsart @default(FINANZIERUNG_110)
  eigenkapitalquoteManuellProzent Float?
  /// Anschlussfinanzierung nach Ablauf der Zinsbindung: der neue Zinssatz wird
  /// als (zinssatzProzent + anschlusszinsAufschlagProzent) angenommen, ab da mit
  /// gleichem Tilgungssatz neu auf die dann aktuelle Restschuld berechnet.
  /// Bewusste Vereinfachung: nur EIN Zinssprung wird simuliert, keine
  /// wiederkehrende Anschlussfinanzierung bei mehrfachem Zinsbindungsablauf.
  anschlusszinsAufschlagProzent  Float @default(1)
  /// Geplante jährliche Sondertilgung, in % der ursprünglichen Darlehenssumme
  /// (nicht der jeweils aktuellen Restschuld — entspricht der üblichen
  /// vertraglichen Definition des Sondertilgungsrechts). Default 0 = keine
  /// Sondertilgung geplant. Reduziert die Restschuld zusätzlich zur regulären
  /// Tilgung, wirkt sich aber NICHT auf die laufende monatliche Cashflow-/
  /// Schuldendienst-Berechnung aus (bewusste Vereinfachung: wie eine separate
  /// Kapitaleinlage behandelt, nicht wie eine laufende Kostenposition).
  sondertilgungProzent    Float @default(0)
  /// Vertraglich maximal erlaubte jährliche Sondertilgung (% der ursprünglichen
  /// Darlehenssumme) — sondertilgungProzent darf diesen Wert nie überschreiten.
  sondertilgungMaxProzent Float @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gewerk {
  DACH
  FENSTER
  HEIZUNG
  ELEKTRIK
  SANITAER_BAEDER
  MAUERWERK_FASSADE
  BODENBELAEGE
  SONSTIGES
}

enum EigentumsTyp {
  SONDEREIGENTUM
  GEMEINSCHAFTSEIGENTUM
}

/// Nur für Gewerk FENSTER relevant — beeinflusst die Kostenschätzung zusätzlich zum Zustand.
enum Verglasungsart {
  EINFACH
  DOPPEL
  DREIFACH
}

model PropertyGewerk {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  gewerk               Gewerk
  zustand              Int          @default(3) // 1 (sehr gut) – 6 (sehr schlecht)
  eigentumsTyp         EigentumsTyp @default(SONDEREIGENTUM)
  geschaetzteKostenOverride Float?
  kommentar            String?
  /// Baujahr/Einbaujahr dieses Gewerks (optional) — Alter fließt in Formel-Kontext & Verhandlungsargumente ein.
  baujahr              Int?
  /// Nur bei gewerk = FENSTER ausgewertet.
  verglasung           Verglasungsart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model PropertyExit {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  geplant        Boolean @default(false)
  haltedauerJahre Int    @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Referenzdaten (im UI editierbar, dienen als Startwerte/Vergleichsbasis)
// ---------------------------------------------------------------------------

model ReferenceGrunderwerbsteuer {
  id           String     @id @default(cuid())
  bundesland   Bundesland @unique
  satzProzent  Float
  gueltigAb    DateTime   @default(now())
  quelle       String?
  updatedAt    DateTime   @updatedAt
}

model ReferenceMietpreis {
  id             String     @id @default(cuid())
  bundesland     Bundesland
  lagetyp        Lagetyp
  mietpreisProM2 Float
  aktualisiertAm DateTime   @default(now())

  @@unique([bundesland, lagetyp])
}

model ReferenceGewerkKosten {
  id             String     @id @default(cuid())
  gewerk         Gewerk     @unique
  kostenProM2Min Float
  kostenProM2Max Float
  aktualisiertAm DateTime   @default(now())
}

model ReferenceInstandhaltungssatz {
  id                    String   @id @default(cuid())
  altersklasseVonJahren Int
  altersklasseBisJahren Int?
  satzProM2ProJahr      Float
  aktualisiertAm        DateTime @default(now())
}

/// Typische Nutzungsdauer je Gewerk (Jahre) — grober Richtwert, keine
/// Herstellerangabe. Dient als Vergleichsbasis für Verhandlungsargumente,
/// wenn ein Gewerk-Baujahr erfasst wurde.
model ReferenceNutzungsdauer {
  id                String   @id @default(cuid())
  gewerk            Gewerk   @unique
  nutzungsdauerJahre Int
  aktualisiertAm    DateTime @default(now())
}

/// Singleton (wie UserProfile) für allgemeine Standardwerte, die neue
/// Objekte vorausfüllen bzw. die computed-with-override-Felder vorschlagen.
/// Alle "standard*"-Felder sind bewusst nullable: null = kein Standard
/// gesetzt, das hartcodierte Fallback aus defaultPropertyFormValues() gilt.
/// Jedes vorausgefüllte Feld bleibt pro Objekt frei überschreibbar.
model ReferenceKaufnebenkostenDefaults {
  id                 String      @id @default(cuid())
  notarProzent       Float       @default(1.0)
  grundbuchProzent   Float       @default(0.5)
  standardBundesland Bundesland?

  standardZinssatzProzent         Float?
  standardTilgungProzent          Float?
  standardZinsbindungJahre        Int?
  standardFinanzierungsart        Finanzierungsart?
  standardMietsteigerungProzent   Float?
  standardWertsteigerungProzent   Float?
  standardKostensteigerungProzent Float?
  standardLeerstandsquoteProzent  Float?
  standardAnschlusszinsAufschlagProzent Float?
  standardSondertilgungProzent    Float?
  standardSondertilgungMaxProzent Float?

  updatedAt DateTime @updatedAt
}

/// Vergleichswert für Kaufpreisfaktor (= Kaufpreis / Jahreskaltmiete) je
/// Objekttyp und Lagetyp — Bruttomietrendite ergibt sich als Kehrwert
/// (100 / Kaufpreisfaktor) und wird nicht separat gespeichert, damit beide
/// Werte nicht auseinanderlaufen können. Dient als Verhandlungs-Referenz.
model ReferenceKaufpreisfaktor {
  id                      String   @id @default(cuid())
  objekttyp               Objekttyp
  lagetyp                 Lagetyp
  kaufpreisfaktorReferenz Float
  aktualisiertAm          DateTime @default(now())

  @@unique([objekttyp, lagetyp])
}
